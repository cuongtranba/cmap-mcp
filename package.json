{
  "name": "cmap-mcp",
  "version": "0.1.0",
  "description": "CLI và máy chủ MCP cho cmap.vn, bản đồ văn hóa Việt Nam",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cmap": "dist/cli.js",
    "cmap-mcp": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuongtranba/cmap-mcp.git"
  },
  "homepage": "https://github.com/cuongtranba/cmap-mcp#readme",
  "bugs": {
    "url": "https://github.com/cuongtranba/cmap-mcp/issues"
  },
  "keywords": [
    "cmap",
    "cmap.vn",
    "vietnam",
    "culture",
    "events",
    "festivals",
    "mcp",
    "model-context-protocol",
    "cli"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:live": "bun test --path-ignore-patterns \"none/**\" test/live --timeout 180000",
    "build": "bun run scripts/build.ts",
    "build:bin": "bun run scripts/build.ts --bin",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "fixtures:record": "bun run scripts/record-fixtures.ts",
    "sync:once": "bun run scripts/sync-once.ts",
    "contract:record": "bun run scripts/record-contract.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "p-limit": "^7.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
